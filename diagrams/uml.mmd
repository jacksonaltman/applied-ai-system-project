classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Category {
        <<enumeration>>
        FEEDING
        WALK
        MEDICATION
        GROOMING
        PLAY
        OTHER
    }

    class Owner {
        +String name
        +int available_time
        +List~Pet~ pets
        +List~Task~ tasks
        +add_pet(pet)
        +remove_pet(pet)
        +add_task(task)
        +remove_task(task)
    }

    class Pet {
        +String id
        +String name
        +String breed
    }

    class Task {
        +String name
        +Category category
        +int duration
        +Priority priority
        +Pet pet
    }

    class ScheduledTask {
        +Task task
        +int start_minute
        +end_minute()
    }

    class Plan {
        +Owner owner
        +int time_limit
        +List~ScheduledTask~ scheduled
        +List~Task~ skipped
        +List~String~ reasoning
        +effective_time_limit()
        +generate_schedule()
        +display_plan()
        +explain_reasoning()
    }

    Owner "1" -- "0..*" Pet : owns
    Owner "1" -- "0..*" Task : manages
    Task "0..*" -- "1" Pet : is for
    Task --> Category
    Task --> Priority
    Plan "1" -- "1" Owner : uses constraints of
    Plan "1" -- "0..*" ScheduledTask : schedules
    Plan "1" -- "0..*" Task : skips
    ScheduledTask "1" -- "1" Task : wraps
