classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Task {
        +String description
        +datetime time
        +int duration
        +Frequency frequency
        +Priority priority
        +bool completed
        +String pet_name
        +end_time()
        +mark_complete()
    }

    class Pet {
        +String id
        +String name
        +String breed
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Owner {
        +String name
        +int available_time
        +List~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_pet(name)
        +get_all_tasks()
    }

    class Scheduler {
        +Owner owner
        +List~Task~ scheduled
        +List~Task~ skipped
        +List~String~ reasoning
        +get_all_tasks()
        +pending_tasks()
        +sort_by_time()
        +filter_tasks()
        +complete_task(task)
        +find_conflicts()
        +generate_schedule()
        +display_plan()
        +explain_reasoning()
    }

    Owner "1" -- "0..*" Pet : owns
    Pet "1" -- "0..*" Task : has
    Scheduler "1" --> "1" Owner : reads get_all_tasks()
    Task --> Frequency
    Task --> Priority
